# ============================================================
# browser-use-sync configuration
# ============================================================

# Python venv where browser-use is installed.
BROWSER_ENV=/opt/browser-env

# Dedicated automation Chrome: CDP port + profile dir.
# The profile dir is where the SYNCED GOOGLE PROFILE lives
# (downloaded from the browser-profile release, saved back after runs).
CDP_PORT=9222
CHROME_PROFILE=/tmp/bu-profile

# The harness attaches to this HTTP DevTools endpoint.
BU_CDP_URL=http://127.0.0.1:${CDP_PORT}

# Screen for the virtual display (Xvfb) that hosts the headed Chrome.
BROWSER_SCREEN=1280x720

# GitHub Release that stores the packed profile (see profile.sh).
PROFILE_RELEASE=browser-profile
PROFILE_ASSET=profile.tar.gz

# ── AI-driven browsing (optional) ────────────────────────
# browser-use tab control works without an LLM. For AI agent
# tasks (browser-use Agent), set these to any OpenAI-compatible
# endpoint — defaults to our opencode.ai big-pickle provider.
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_MODEL="big-pickle"
OPENCODE_API_KEY=""
